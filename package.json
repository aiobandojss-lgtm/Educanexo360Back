    "@types/morgan": "^1.9.9",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
