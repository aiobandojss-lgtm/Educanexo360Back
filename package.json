    "build": "tsc",
    "watch-ts": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "check-types": "tsc --noEmit",
    "seed:reviewers": "ts-node --transpile-only src/scripts/seed-reviewers.ts",
    "test:mensajeria": "node src/tests/mensajeria/test-mensajes-endpoints.mjs",
    "type": "commonjs",
    "postinstall": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
